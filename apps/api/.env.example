DATABASE_URL="postgresql://findi:findi@localhost:5432/findi?schema=public"
JWT_SECRET="change-me-in-every-environment"
PORT=4000
REDIS_URL="redis://localhost:6379"

# Payment gateway — still an open decision (feature spec §18, decision #2).
# Populate once a gateway + sandbox account is confirmed.
PAYMENT_GATEWAY_API_KEY=""
PAYMENT_GATEWAY_WEBHOOK_SECRET=""

# Findi mailbox hosting — domains.co.za (cPanel).
MAIL_HOST="cpXX.domains.co.za"
MAIL_IMAP_PORT=993
MAIL_SMTP_PORT=465
MAIL_POP3_PORT=995
MAIL_TLS=true

# Encrypts mailbox passwords stored in the MailAccount table (AES-256-GCM).
# Generate one per environment: `openssl rand -hex 32` — never reuse across environments.
MAIL_ENCRYPTION_KEY=""

# Seed mailboxes (created manually in cPanel before the portal could provision its own).
MAIL_INFO_ADDRESS="info@findi.co.za"
MAIL_INFO_PASSWORD=""
MAIL_MELANIE_ADDRESS="melanie@findi.co.za"
MAIL_MELANIE_PASSWORD=""

# cPanel control-panel API access — needed for the portal to create/delete mailboxes
# (UAPI Email::add_pop / Email::delete_pop). NOT a mailbox login — the hosting account itself.
MAIL_CPANEL_HOST=""
MAIL_CPANEL_PORT=2083
MAIL_CPANEL_USERNAME=""
MAIL_CPANEL_PASSWORD=""
